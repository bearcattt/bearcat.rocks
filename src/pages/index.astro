---
import '@/global.css';
import { ArrowUpRight, Github, MessageCircle, Terminal } from 'lucide-astro';

const projects = [
  {
    name: 'Lunar',
    type: 'Web platform',
    description: 'A game and utility hub, built around a fast, clean interface.',
    href: 'https://lunaron.top',
  },
  {
    name: 'Solar',
    type: 'Discord bot',
    description: 'A cat-themed bot with moderation filters, AFK tools, and more.',
    href: 'https://discord.com/oauth2/authorize?client_id=1340857806177177760&permissions=563226978929665&integration_type=0&scope=bot',
  },
];

const skills = ['Astro', 'TypeScript', 'JavaScript', 'Tailwind', 'Node.js', 'Python', 'Linux'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101316" />
    <title>Bearcat — Developer</title>
    <meta name="description" content="Bearcat is a developer interested in the web, open tools, and internet freedom." />
    <meta property="og:title" content="Bearcat — Developer" />
    <meta property="og:description" content="A little about what I make and what I care about." />
    <meta property="og:image" content="/a/tutle.webp" />
    <link rel="icon" href="/a/tutle.webp" type="image/webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="page-shell">
      <header class="topline">
        <a class="wordmark" href="/" aria-label="Bearcat home"><Terminal size={17} strokeWidth={1.8} /> <span>bearcat<span class="wordmark-dot">.</span></span></a>
        <span class="availability"><span class="availability-mark"></span> BUILDING ON THE WEB</span>
      </header>

      <section class="intro" aria-labelledby="intro-title">
        <div class="avatar-frame"><img src="/a/tutle.webp" alt="Bearcat's turtle avatar" /></div>
        <div class="intro-copy">
          <p class="eyebrow">INDEPENDENT DEVELOPER <span>·</span> ONLINE</p>
          <h1 id="intro-title">Hey, I’m <span>Bearcat.</span></h1>
          <p class="lede">I like making things for the web and figuring out how the internet works. Interested in open tools, good interfaces, and a less restricted web.</p>
          <nav class="social-links" aria-label="Find me online">
            <a href="https://github.com/bearcattt" target="_blank" rel="noreferrer"><Github size={16} /> GitHub <ArrowUpRight size={13} /></a>
            <a href="https://discord.com/users/997203884428767282" target="_blank" rel="noreferrer"><MessageCircle size={16} /> Discord <ArrowUpRight size={13} /></a>
          </nav>
        </div>
      </section>

      <section class="work-section" aria-labelledby="work-title">
        <div class="section-heading"><h2 id="work-title">Selected work</h2><span>01 — 02</span></div>
        <div class="project-list">
          {projects.map((project, index) => (
            <a class="project" href={project.href} target="_blank" rel="noreferrer">
              <span class="project-index">0{index + 1}</span>
              <span class="project-main">
                <span class="project-title">{project.name}<ArrowUpRight size={15} /></span>
                <span class="project-description">{project.description}</span>
              </span>
              <span class="project-type">{project.type}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="stack-section" aria-labelledby="stack-title">
        <div class="section-heading"><h2 id="stack-title">Tools I reach for</h2><span>THE TOOLBOX</span></div>
        <ul class="skill-list">{skills.map((skill) => <li>{skill}</li>)}</ul>
      </section>

      <footer><span>Curious by default.</span><span>© {new Date().getFullYear()} Bearcat</span></footer>
    </main>
  </body>
</html>
