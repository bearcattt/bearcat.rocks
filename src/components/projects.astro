---
import { ExternalLink, Github } from 'lucide-astro';
const { name, description, href, github } = Astro.props;
---

<div class="flex items-start justify-between gap-5 px-0.5 py-[18px]">
  <a
    href={href}
    target="_blank"
    rel="noreferrer"
    class="project-link min-w-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#9ccfd8]">
    <h3 class="mb-1 text-base leading-[1.35] font-medium">{name}</h3>
    <p class="max-w-lg text-sm leading-[1.55] text-[#908caa]">{description}</p>
  </a>
  <div class="mt-1 flex shrink-0 items-center gap-3 text-[#908caa]">
    <a
      href={href}
      target="_blank"
      rel="noreferrer"
      aria-label={`Open ${name} project`}
      class="project-action focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#9ccfd8]">
      <ExternalLink aria-hidden="true" class="h-4 w-4" />
    </a>
    {github && (
      <a
        href={github}
        target="_blank"
        rel="noreferrer"
        aria-label={`${name} on GitHub`}
        class="project-github focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#9ccfd8]">
        <Github aria-hidden="true" class="h-4 w-4" />
      </a>
    )}
  </div>
</div>
