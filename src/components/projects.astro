---
import { ExternalLink } from 'lucide-astro';
const { name, description, href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noreferrer"
  class="project-link flex items-start justify-between gap-5 px-0.5 py-[18px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#9ccfd8]">
  <div class="min-w-0">
    <h3 class="mb-1 text-base leading-[1.35] font-medium">{name}</h3>
    <p class="max-w-lg text-sm leading-[1.55] text-[#908caa]">{description}</p>
  </div>
  <ExternalLink aria-hidden="true" class="mt-1 h-4 w-4 shrink-0 text-[#908caa]" />
</a>
